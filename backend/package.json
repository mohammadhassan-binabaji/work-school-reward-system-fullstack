    "@fastify/swagger-ui": "^4.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.33.15",
    "csv-stringify": "^6.5.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^6.0.2",
