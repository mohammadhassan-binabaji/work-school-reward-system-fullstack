# Production API & Version Configuration Example
# Copy this file to .env.production before building the release APK/AAB:
# cp .env.production.example .env.production

# 1. Real Production HTTPS API Base URL (DO NOT use localhost or 127.0.0.1 in production Android builds)
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# 2. Public HTTPS URL for app-version.json served by Nginx from the Student Frontend web origin
VITE_APP_VERSION_URL=https://student.yourdomain.com/app-version.json
