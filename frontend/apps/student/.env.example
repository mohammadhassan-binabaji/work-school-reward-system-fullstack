# Local Development API URL (for local browser dev server)
# Note: On an Android emulator, 'localhost' points to the emulator itself, not the host machine.
# To connect to host machine backend from an Android emulator during dev, use: http://10.0.2.2:3000/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_STORAGE_BASE_URL=http://localhost:3000

# Optional override for app-version.json during local testing (defaults to /app-version.json)
# VITE_APP_VERSION_URL=http://localhost:5173/app-version.json
